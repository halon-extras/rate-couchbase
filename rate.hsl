import { Couchbase } from "extras://couchbase";

function rate_get_counter($couchbase, $key) {
    $response = $couchbase->get($key);

    if ($response["error"]) {
        if ($response["error"]["code"] == 101)
            return 0;
        throw Exception(json_encode($response["error"]));
    }

    return number($response["result"]);
}

function rate_fixed_window($namespace, $entry, $count, $interval, $options = []) {
    if (isset($options["profile"]))
        $couchbase = Couchbase($options["profile"], $options["bucket"]);
    else
        $couchbase = Couchbase();

    $window = floor(time() / $interval);
    $key = "$namespace:$entry:$window";

    if ($count === 0) {
        return rate_get_counter($couchbase, $key);
    }

    $current = $couchbase->increment($key, 1, [ "initial" => 1, "expiry" => $interval * 2 ]);

    if ($current["error"])
        throw Exception(json_encode($current["error"]));

    return $current["result"] <= $count;
}

